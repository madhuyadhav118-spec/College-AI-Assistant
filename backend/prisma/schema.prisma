generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model departments {
  department_id   Int         @id @default(autoincrement())
  department_name String      @unique(map: "department_name") @db.VarChar(100)
  department_code String      @unique(map: "department_code") @db.VarChar(20)
  hod_name        String?     @db.VarChar(100)
  email           String?     @db.VarChar(100)
  phone           String?     @db.VarChar(15)
  building_name   String?     @db.VarChar(100)
  created_at      DateTime?   @default(now()) @db.Timestamp(0)
  updated_at      DateTime?   @default(now()) @db.Timestamp(0)
  course_id       Int?
  courses         courses?    @relation(fields: [course_id], references: [course_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_department_course")
  faculty         faculty[]
  students        students[]
  subjects        subjects[]
  timetable       timetable[]

  @@index([course_id], map: "fk_department_course")
}

model subjects {
  subject_id    Int            @id @default(autoincrement())
  subject_name  String         @db.VarChar(100)
  subject_code  String         @unique(map: "subject_code") @db.VarChar(20)
  department_id Int
  semester      Int
  year          Int
  credits       Int
  created_at    DateTime?      @default(now()) @db.Timestamp(0)
  updated_at    DateTime?      @default(now()) @db.Timestamp(0)
  assignments   assignments[]
  examinations  examinations[]
  results       results[]
  departments   departments    @relation(fields: [department_id], references: [department_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_subject_department")
  timetable     timetable[]

  @@index([department_id], map: "fk_subject_department")
}

model courses {
  course_id      Int           @id @default(autoincrement())
  course_name    String        @db.VarChar(100)
  course_code    String        @unique(map: "course_code") @db.VarChar(20)
  duration_years Int
  created_at     DateTime?     @default(now()) @db.Timestamp(0)
  updated_at     DateTime?     @default(now()) @db.Timestamp(0)
  departments    departments[]
}

model faculty {
  faculty_id    Int             @id @default(autoincrement())
  user_id       Int
  employee_id   String          @unique(map: "employee_id") @db.VarChar(30)
  department    String          @db.VarChar(100)
  designation   String?         @db.VarChar(100)
  qualification String?         @db.VarChar(100)
  experience    Int?
  joining_date  DateTime?       @db.Date
  office_phone  String?         @db.VarChar(15)
  status        faculty_status? @default(ACTIVE)
  created_at    DateTime?       @default(now()) @db.Timestamp(0)
  updated_at    DateTime?       @default(now()) @db.Timestamp(0)
  department_id Int?
  assignments   assignments[]
  attendance    attendance[]
  users         users           @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "faculty_ibfk_1")
  departments   departments?    @relation(fields: [department_id], references: [department_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_faculty_department")
  timetable     timetable[]

  @@index([department_id], map: "fk_faculty_department")
  @@index([user_id], map: "user_id")
}

model students {
  student_id             Int                      @id @default(autoincrement())
  user_id                Int
  roll_number            String                   @unique(map: "roll_number") @db.VarChar(30)
  admission_number       String?                  @unique(map: "admission_number") @db.VarChar(30)
  department             String                   @db.VarChar(100)
  year                   Int
  semester               Int
  section                String?                  @db.VarChar(10)
  gender                 String?                  @db.VarChar(10)
  date_of_birth          DateTime?                @db.Date
  address                String?                  @db.Text
  parent_name            String?                  @db.VarChar(100)
  parent_phone           String?                  @db.VarChar(15)
  blood_group            String?                  @db.VarChar(5)
  admission_date         DateTime?                @db.Date
  status                 students_status?         @default(ACTIVE)
  created_at             DateTime?                @default(now()) @db.Timestamp(0)
  updated_at             DateTime?                @default(now()) @db.Timestamp(0)
  department_id          Int?
  assignment_submissions assignment_submissions[]
  attendance             attendance[]
  feedback               feedback[]
  fees                   fees[]
  library_issues         library_issues[]
  placement_applications placement_applications[]
  results                results[]
  departments            departments?             @relation(fields: [department_id], references: [department_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_student_department")
  users                  users                    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "students_ibfk_1")

  @@index([department_id], map: "fk_student_department")
  @@index([user_id], map: "user_id")
}

model users {
  user_id        Int              @id @default(autoincrement())
  full_name      String           @db.VarChar(100)
  email          String           @unique(map: "email") @db.VarChar(100)
  password       String           @db.VarChar(255)
  role           users_role
  phone          String?          @db.VarChar(15)
  profile_image  String?          @db.VarChar(255)
  is_active      Boolean?         @default(true)
  last_login     DateTime?        @db.Timestamp(0)
  created_at     DateTime?        @default(now()) @db.Timestamp(0)
  updated_at     DateTime?        @default(now()) @db.Timestamp(0)
  faculty        faculty[]
  leave_requests leave_requests[]
  students       students[]
}

model attendance {
  attendance_id   Int                @id @default(autoincrement())
  student_id      Int
  faculty_id      Int
  attendance_date DateTime           @db.Date
  status          attendance_status? @default(PRESENT)
  remarks         String?            @db.VarChar(255)
  created_at      DateTime?          @default(now()) @db.Timestamp(0)
  updated_at      DateTime?          @default(now()) @db.Timestamp(0)
  faculty         faculty            @relation(fields: [faculty_id], references: [faculty_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_attendance_faculty")
  students        students           @relation(fields: [student_id], references: [student_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_attendance_student")

  @@index([faculty_id], map: "fk_attendance_faculty")
  @@index([student_id], map: "fk_attendance_student")
}

model timetable {
  timetable_id  Int                   @id @default(autoincrement())
  subject_id    Int
  faculty_id    Int
  department_id Int
  day_of_week   timetable_day_of_week
  start_time    DateTime              @db.Time(0)
  end_time      DateTime              @db.Time(0)
  room_number   String?               @db.VarChar(20)
  created_at    DateTime?             @default(now()) @db.Timestamp(0)
  updated_at    DateTime?             @default(now()) @db.Timestamp(0)
  subjects      subjects              @relation(fields: [subject_id], references: [subject_id], onDelete: NoAction, onUpdate: NoAction, map: "timetable_ibfk_1")
  faculty       faculty               @relation(fields: [faculty_id], references: [faculty_id], onDelete: NoAction, onUpdate: NoAction, map: "timetable_ibfk_2")
  departments   departments           @relation(fields: [department_id], references: [department_id], onDelete: NoAction, onUpdate: NoAction, map: "timetable_ibfk_3")

  @@index([department_id], map: "department_id")
  @@index([faculty_id], map: "faculty_id")
  @@index([subject_id], map: "subject_id")
}

model examinations {
  exam_id     Int                    @id @default(autoincrement())
  subject_id  Int
  exam_name   String                 @db.VarChar(100)
  exam_type   examinations_exam_type
  exam_date   DateTime               @db.Date
  start_time  DateTime               @db.Time(0)
  end_time    DateTime               @db.Time(0)
  venue       String?                @db.VarChar(100)
  total_marks Int?                   @default(100)
  created_at  DateTime?              @default(now()) @db.Timestamp(0)
  updated_at  DateTime?              @default(now()) @db.Timestamp(0)
  subjects    subjects               @relation(fields: [subject_id], references: [subject_id], onDelete: NoAction, onUpdate: NoAction, map: "examinations_ibfk_1")
  results     results[]

  @@index([subject_id], map: "subject_id")
}

model results {
  result_id      Int                    @id @default(autoincrement())
  student_id     Int
  subject_id     Int
  exam_id        Int
  marks_obtained Decimal                @db.Decimal(5, 2)
  grade          String?                @db.VarChar(5)
  result_status  results_result_status? @default(PASS)
  remarks        String?                @db.VarChar(255)
  created_at     DateTime?              @default(now()) @db.Timestamp(0)
  updated_at     DateTime?              @default(now()) @db.Timestamp(0)
  examinations   examinations           @relation(fields: [exam_id], references: [exam_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_result_exam")
  students       students               @relation(fields: [student_id], references: [student_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_result_student")
  subjects       subjects               @relation(fields: [subject_id], references: [subject_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_result_subject")

  @@index([exam_id], map: "fk_result_exam")
  @@index([student_id], map: "fk_result_student")
  @@index([subject_id], map: "fk_result_subject")
}

model fees {
  fee_id         Int                  @id @default(autoincrement())
  student_id     Int
  academic_year  String               @db.VarChar(20)
  semester       Int
  total_fee      Decimal              @db.Decimal(10, 2)
  amount_paid    Decimal?             @default(0.00) @db.Decimal(10, 2)
  balance        Decimal              @db.Decimal(10, 2)
  due_date       DateTime?            @db.Date
  payment_status fees_payment_status? @default(PENDING)
  remarks        String?              @db.VarChar(255)
  created_at     DateTime?            @default(now()) @db.Timestamp(0)
  updated_at     DateTime?            @default(now()) @db.Timestamp(0)
  students       students             @relation(fields: [student_id], references: [student_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_fee_student")

  @@index([student_id], map: "fk_fee_student")
}

model notices {
  notice_id    Int               @id @default(autoincrement())
  title        String            @db.VarChar(150)
  description  String            @db.Text
  audience     notices_audience? @default(ALL)
  priority     notices_priority? @default(MEDIUM)
  publish_date DateTime          @db.Date
  expiry_date  DateTime?         @db.Date
  created_at   DateTime?         @default(now()) @db.Timestamp(0)
  updated_at   DateTime?         @default(now()) @db.Timestamp(0)
}

model assignments {
  assignment_id          Int                      @id @default(autoincrement())
  subject_id             Int
  faculty_id             Int
  title                  String                   @db.VarChar(150)
  description            String?                  @db.Text
  due_date               DateTime                 @db.Date
  max_marks              Int?                     @default(100)
  created_at             DateTime?                @default(now()) @db.Timestamp(0)
  updated_at             DateTime?                @default(now()) @db.Timestamp(0)
  assignment_submissions assignment_submissions[]
  faculty                faculty                  @relation(fields: [faculty_id], references: [faculty_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assignment_faculty")
  subjects               subjects                 @relation(fields: [subject_id], references: [subject_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assignment_subject")

  @@index([faculty_id], map: "fk_assignment_faculty")
  @@index([subject_id], map: "fk_assignment_subject")
}

model assignment_submissions {
  submission_id   Int                            @id @default(autoincrement())
  assignment_id   Int
  student_id      Int
  submission_date DateTime?                      @default(now()) @db.DateTime(0)
  file_url        String?                        @db.VarChar(255)
  remarks         String?                        @db.VarChar(255)
  marks_obtained  Decimal?                       @db.Decimal(5, 2)
  status          assignment_submissions_status? @default(SUBMITTED)
  created_at      DateTime?                      @default(now()) @db.Timestamp(0)
  updated_at      DateTime?                      @default(now()) @db.Timestamp(0)
  assignments     assignments                    @relation(fields: [assignment_id], references: [assignment_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_submission_assignment")
  students        students                       @relation(fields: [student_id], references: [student_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_submission_student")

  @@index([assignment_id], map: "fk_submission_assignment")
  @@index([student_id], map: "fk_submission_student")
}

model leave_requests {
  leave_id   Int                       @id @default(autoincrement())
  user_id    Int
  leave_type leave_requests_leave_type
  start_date DateTime                  @db.Date
  end_date   DateTime                  @db.Date
  reason     String?                   @db.VarChar(255)
  status     leave_requests_status?    @default(PENDING)
  created_at DateTime?                 @default(now()) @db.Timestamp(0)
  updated_at DateTime?                 @default(now()) @db.Timestamp(0)
  users      users                     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_leave_user")

  @@index([user_id], map: "fk_leave_user")
}

model events {
  event_id    Int               @id @default(autoincrement())
  event_title String            @db.VarChar(150)
  event_type  events_event_type
  description String?           @db.Text
  event_date  DateTime          @db.Date
  start_time  DateTime          @db.Time(0)
  end_time    DateTime          @db.Time(0)
  venue       String?           @db.VarChar(100)
  organizer   String?           @db.VarChar(100)
  created_at  DateTime?         @default(now()) @db.Timestamp(0)
  updated_at  DateTime?         @default(now()) @db.Timestamp(0)
}

model library_books {
  book_id          Int              @id @default(autoincrement())
  book_title       String           @db.VarChar(200)
  author           String           @db.VarChar(150)
  isbn             String?          @unique(map: "isbn") @db.VarChar(30)
  category         String?          @db.VarChar(100)
  publisher        String?          @db.VarChar(150)
  publication_year Int?
  total_copies     Int
  available_copies Int
  shelf_location   String?          @db.VarChar(100)
  created_at       DateTime?        @default(now()) @db.Timestamp(0)
  updated_at       DateTime?        @default(now()) @db.Timestamp(0)
  library_issues   library_issues[]
}

model library_issues {
  issue_id      Int                    @id @default(autoincrement())
  book_id       Int
  student_id    Int
  issue_date    DateTime               @db.Date
  due_date      DateTime               @db.Date
  return_date   DateTime?              @db.Date
  status        library_issues_status? @default(ISSUED)
  fine_amount   Decimal?               @default(0.00) @db.Decimal(8, 2)
  created_at    DateTime?              @default(now()) @db.Timestamp(0)
  updated_at    DateTime?              @default(now()) @db.Timestamp(0)
  library_books library_books          @relation(fields: [book_id], references: [book_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_issue_book")
  students      students               @relation(fields: [student_id], references: [student_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_issue_student")

  @@index([book_id], map: "fk_issue_book")
  @@index([student_id], map: "fk_issue_student")
}

model placements {
  placement_id           Int                      @id @default(autoincrement())
  company_name           String                   @db.VarChar(150)
  job_role               String                   @db.VarChar(100)
  eligibility            String?                  @db.VarChar(100)
  ctc                    Decimal?                 @db.Decimal(10, 2)
  job_location           String?                  @db.VarChar(100)
  drive_date             DateTime?                @db.Date
  application_deadline   DateTime?                @db.Date
  description            String?                  @db.Text
  status                 placements_status?       @default(OPEN)
  created_at             DateTime?                @default(now()) @db.Timestamp(0)
  updated_at             DateTime?                @default(now()) @db.Timestamp(0)
  placement_applications placement_applications[]
}

model placement_applications {
  application_id Int                            @id @default(autoincrement())
  placement_id   Int
  student_id     Int
  resume_url     String?                        @db.VarChar(255)
  applied_date   DateTime                       @db.Date
  status         placement_applications_status? @default(APPLIED)
  remarks        String?                        @db.VarChar(255)
  created_at     DateTime?                      @default(now()) @db.Timestamp(0)
  updated_at     DateTime?                      @default(now()) @db.Timestamp(0)
  placements     placements                     @relation(fields: [placement_id], references: [placement_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_application_placement")
  students       students                       @relation(fields: [student_id], references: [student_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_application_student")

  @@index([placement_id], map: "fk_application_placement")
  @@index([student_id], map: "fk_application_student")
}

model hostel_rooms {
  room_id     Int                    @id @default(autoincrement())
  room_number String                 @db.VarChar(20)
  hostel_name String                 @db.VarChar(100)
  room_type   hostel_rooms_room_type
  capacity    Int
  occupied    Int?                   @default(0)
  floor_no    Int?
  status      hostel_rooms_status?   @default(AVAILABLE)
  created_at  DateTime?              @default(now()) @db.Timestamp(0)
  updated_at  DateTime?              @default(now()) @db.Timestamp(0)
}

model transport_buses {
  bus_id          Int                     @id @default(autoincrement())
  bus_number      String                  @unique(map: "bus_number") @db.VarChar(30)
  route_name      String                  @db.VarChar(100)
  driver_name     String                  @db.VarChar(100)
  driver_phone    String?                 @db.VarChar(15)
  capacity        Int
  available_seats Int
  status          transport_buses_status? @default(ACTIVE)
  created_at      DateTime?               @default(now()) @db.Timestamp(0)
  updated_at      DateTime?               @default(now()) @db.Timestamp(0)
}

model feedback {
  feedback_id   Int                    @id @default(autoincrement())
  student_id    Int
  feedback_type feedback_feedback_type
  subject       String                 @db.VarChar(150)
  message       String                 @db.Text
  rating        Int?
  status        feedback_status?       @default(PENDING)
  created_at    DateTime?              @default(now()) @db.Timestamp(0)
  updated_at    DateTime?              @default(now()) @db.Timestamp(0)
  students      students               @relation(fields: [student_id], references: [student_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_feedback_student")

  @@index([student_id], map: "fk_feedback_student")
}

enum users_role {
  ADMIN
  FACULTY
  STUDENT
}

enum faculty_status {
  ACTIVE
  INACTIVE
}

enum students_status {
  ACTIVE
  GRADUATED
  SUSPENDED
}

enum attendance_status {
  PRESENT
  ABSENT
  LATE
}

enum timetable_day_of_week {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
}

enum examinations_exam_type {
  MID1
  MID2
  SEMESTER
  LAB
  PRACTICAL
}

enum results_result_status {
  PASS
  FAIL
}

enum fees_payment_status {
  PENDING
  PARTIAL
  PAID
}

enum notices_audience {
  ALL
  STUDENT
  FACULTY
}

enum notices_priority {
  LOW
  MEDIUM
  HIGH
}

enum assignment_submissions_status {
  SUBMITTED
  EVALUATED
  LATE
}

enum leave_requests_leave_type {
  SICK
  CASUAL
  EMERGENCY
  OTHER
}

enum leave_requests_status {
  PENDING
  APPROVED
  REJECTED
}

enum events_event_type {
  WORKSHOP
  SEMINAR
  HACKATHON
  SPORTS
  CULTURAL
  PLACEMENT
  OTHER
}

enum library_issues_status {
  ISSUED
  RETURNED
  OVERDUE
}

enum placements_status {
  OPEN
  CLOSED
}

enum placement_applications_status {
  APPLIED
  SHORTLISTED
  SELECTED
  REJECTED
}

enum hostel_rooms_room_type {
  SINGLE
  DOUBLE
  TRIPLE
  FOUR_SHARING
}

enum hostel_rooms_status {
  AVAILABLE
  FULL
  MAINTENANCE
}

enum transport_buses_status {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum feedback_feedback_type {
  FACULTY
  COURSE
  HOSTEL
  TRANSPORT
  GENERAL
}

enum feedback_status {
  PENDING
  REVIEWED
  RESOLVED
}
